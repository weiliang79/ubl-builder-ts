{
  "name": "@weiliang79/ubl-builder",
  "version": "0.3.0",
  "description": "Build OASIS UBL 2.1 documents as XML or UBL JSON, with country profiles \u2014 Malaysia MyInvois included",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cac": {
      "types": "./dist/cac/index.d.ts",
      "default": "./dist/cac/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./datatypes": {
      "types": "./dist/datatypes/index.d.ts",
      "default": "./dist/datatypes/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "default": "./dist/documents/index.js"
    },
    "./ext": {
      "types": "./dist/ext/index.d.ts",
      "default": "./dist/ext/index.js"
    },
    "./sig": {
      "types": "./dist/sig/index.d.ts",
      "default": "./dist/sig/index.js"
    },
    "./profiles/myinvois": {
      "types": "./dist/profiles/myinvois/index.d.ts",
      "default": "./dist/profiles/myinvois/index.js"
    },
    "./profiles/dian": {
      "types": "./dist/profiles/dian/index.d.ts",
      "default": "./dist/profiles/dian/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "MIGRATION.md"
  ],
  "scripts": {
    "test": "jest --config jest.config.ts",
    "validate:xsd": "bash scripts/validate-fixtures.sh",
    "check:c14n": "bash scripts/check-canonical.sh",
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run lint && npm run typecheck && npm run check:schema && npm run check:types && npm run check:classref && npm run check:c14n && npm test && npm run validate:xsd",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push --follow-tags",
    "publish-npm": "npm publish --access public",
    "report:schema": "ts-node --project tsconfig.json scripts/generator/report.ts",
    "generate:cac": "ts-node --project tsconfig.json scripts/generator/emit.ts",
    "check:schema": "ts-node --project tsconfig.json scripts/generator/emit.ts --check",
    "generate:complete": "ts-node --project tsconfig.json scripts/generator/complete.ts",
    "scaffold": "ts-node --project tsconfig.json scripts/generator/scaffold.ts",
    "check:types": "ts-node --project tsconfig.json scripts/generator/checkTypes.ts",
    "check:classref": "ts-node --project tsconfig.json scripts/generator/checkClassRef.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiliang79/ubl-builder-ts.git"
  },
  "keywords": [
    "ubl",
    "ubl-2.1",
    "ubl-json",
    "e-invoice",
    "einvoicing",
    "myinvois",
    "lhdn",
    "malaysia",
    "oasis",
    "xml",
    "invoice"
  ],
  "author": "Wei Liang Ung <liang2010@hotmail.my> (https://github.com/weiliang79)",
  "contributors": [
    {
      "name": "Felipe Santa",
      "email": "juansantag95@gmail.com",
      "url": "https://github.com/pipesanta"
    },
    {
      "name": "Lars Buur",
      "email": "lars@buur.org"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/weiliang79/ubl-builder-ts/issues"
  },
  "homepage": "https://github.com/weiliang79/ubl-builder-ts#readme",
  "dependencies": {
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@xmldom/xmldom": "^0.8.15",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "xpath": "^0.0.34"
  }
}
